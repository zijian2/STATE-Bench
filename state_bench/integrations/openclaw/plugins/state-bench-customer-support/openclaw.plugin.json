{
  "id": "state-bench-customer-support",
  "name": "STATE-Bench Customer Support Tools",
  "description": "Customer support domain tools for STATE-Bench evaluation",
  "version": "0.1.0",
  "configSchema": {
    "type": "object",
    "properties": {
      "tool_server_url": {
        "type": "string",
        "description": "URL of the tool execution server",
        "default": "http://127.0.0.1:8765"
      }
    },
    "additionalProperties": false
  },
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "get_order",
      "get_customer",
      "search_products",
      "get_product_details",
      "get_policies",
      "get_warranty_status",
      "process_return",
      "process_refund",
      "cancel_order",
      "process_exchange",
      "process_warranty_claim"
    ]
  }
}
